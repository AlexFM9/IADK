<object id="greet_code" type="ingenias.editor.entities.AslCodeComponent">
<property id="aslFile"></property>
<mapproperties>
<key id="Language">AgentSpeak</key>
<key id="Code">+!start : true

   &lt;- turno(N);

      if (N mod 2 == 1) { +mood(happy) } else { +mood(grumpy) };

      ?mood(M);

      .print(&quot;Me despierto &quot;, M);

      .wait(500);

      !saludar.</key>
<key id="aslFile"></key>
<key id="_view_type">INGENIAS</key>
</mapproperties>
</object>
<object id="AslCodeComponent0" type="ingenias.editor.entities.AslCodeComponent">
<property id="aslFile"></property>
<mapproperties>
<key id="Language">AgentSpeak</key>
<key id="Code">?mood(M);

.broadcast(tell, saludo(M));

.wait({+saludado})</key>
<key id="aslFile"></key>
<key id="_view_type">INGENIAS</key>
</mapproperties>
</object>
<object id="reglas_greeter" type="ingenias.editor.entities.AslCodeComponent">
<property id="aslFile"></property>
<mapproperties>
<key id="Language">AgentSpeak</key>
<key id="Code">+saludo(_)[source(S)] : mood(happy)

   &lt;- .print(&quot;Hola, &quot;, S, &quot;. Que alegria verte!&quot;);

      .send(S, tell, respuesta(happy)).

 

+saludo(_)[source(S)] : mood(grumpy)

   &lt;- .print(&quot;Hmpf... hola, &quot;, S, &quot;.&quot;);

      .send(S, tell, respuesta(grumpy)).

 

+respuesta(M)[source(S)]

   &lt;- .print(S, &quot; me ha respondido de humor &quot;, M);

      +saludado.</key>
<key id="aslFile"></key>
<key id="_view_type">INGENIAS</key>
</mapproperties>
</object>
