// =============================================================================
// JaCaMo application saludos, generated by the IDK from the AgentSpeak profile
// diagrams (rewritten every time the code is generated). Run it with
//     ./gradlew run
// =============================================================================

mas saludos {

    // agents: one of each type, or the ones of the deployments (DeploymentPackage,
    // Deploy Diagram) with their number of instances and initial state

    agent greeter : greeter.asl {

        instances: 2




        roles: saludador in saludo_org.team


        join: env


        focus: env.counter

    }


    // CArtAgO workspaces (Workspace, Environment Model) and their artifacts
    // (EnvironmentApplication, EContainsArtifact); env is the default workspace

    workspace env {

        artifact counter : tools.Counter()

    }




    // Moise organisations (Organization Model): their specifications are in src/org

    organisation saludo_org : saludo_org.xml {
        group saludo_org_group : saludo_org {
            group team : team {
                responsible-for: saludo_sch
            }
        }
        scheme saludo_sch : saludo_sch
    }


}
